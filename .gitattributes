# Handle line endings automatically for all files
* text=auto

# Force Unix LF for Dart, YAML, JSON, Kotlin, and Markdown
*.dart text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.kt   text eol=lf
*.kts  text eol=lf
*.gradle text eol=lf
*.xml  text eol=lf
*.cmake text eol=lf

# Binary files — no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.ttf  binary
*.otf  binary
*.apk  binary
*.aab  binary
